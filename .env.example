VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Amazon Associates affiliate tag (optional — links work without it, tag adds commission)
# US tag:  yourname-20        → routes to amazon.com
# UK tag:  yourname-21        → routes to amazon.co.uk
# IN tag:  yourname-22        → routes to amazon.in
# Set whichever market you're targeting; the currency toggle determines which store is used.
VITE_AMAZON_AFFILIATE_TAG=your-tag-20

# ── Amazon Product Advertising API (server-side only) ──────────
# Used by scripts/fetch-amazon-images.mjs to pull licensed product images
# into src/data/perfumeImages.json. Requires an approved Associates account
# with PA-API access. These are NOT VITE_-prefixed on purpose: they must never
# ship to the browser. Run the script locally, commit the generated JSON.
AMAZON_ACCESS_KEY=AKIA...
AMAZON_SECRET_KEY=your-secret-key
AMAZON_PARTNER_TAG=your-tag-20
# Optional overrides (default to the US marketplace):
# AMAZON_HOST=webservices.amazon.com
# AMAZON_REGION=us-east-1
# AMAZON_MARKETPLACE=www.amazon.com
