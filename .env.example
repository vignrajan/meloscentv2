VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Amazon Associates affiliate tags (optional — links work without them; tags add commission)
# Each Amazon marketplace is a SEPARATE Associates program with its own tag.
# A tag only earns on its own store, so set one per region you're approved in.
# The currency toggle (USD/GBP/INR) decides which store + tag a buy link uses.
VITE_AMAZON_TAG_US=meloscent88-20   # amazon.com   (USD) — defaults to this in code if unset
VITE_AMAZON_TAG_UK=your-tag-21      # amazon.co.uk (GBP) — set once approved for the UK program
VITE_AMAZON_TAG_IN=your-tag-21      # amazon.in    (INR) — set once approved for the India program

# Legacy single tag — used as a fallback for any market without its own tag above.
# Kept for backward compatibility; prefer the per-market tags once you have them.
VITE_AMAZON_AFFILIATE_TAG=your-tag-20

# ── Amazon Product Advertising API (server-side only) ──────────
# Used by scripts/fetch-amazon-images.mjs to pull licensed product images
# into src/data/perfumeImages.json. Requires an approved Associates account
# with PA-API access. These are NOT VITE_-prefixed on purpose: they must never
# ship to the browser. Run the script locally, commit the generated JSON.
AMAZON_ACCESS_KEY=AKIA...
AMAZON_SECRET_KEY=your-secret-key
AMAZON_PARTNER_TAG=your-tag-20
#
# The script is region-aware: `node scripts/fetch-amazon-images.mjs --region uk`
# picks the UK PA-API endpoint and reads region-specific creds if present,
# falling back to the un-suffixed vars above. Since PA-API access is granted
# per marketplace, use these to keep each region's keys separate:
# AMAZON_ACCESS_KEY_UK=...   AMAZON_SECRET_KEY_UK=...   AMAZON_PARTNER_TAG_UK=your-tag-21
# AMAZON_ACCESS_KEY_IN=...   AMAZON_SECRET_KEY_IN=...   AMAZON_PARTNER_TAG_IN=your-tag-21
# (Partner tag also falls back to VITE_AMAZON_TAG_UK / _IN.)
